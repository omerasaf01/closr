# Provider API Keys (configure at least one)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Provider & Model Configuration (CLOSR_-prefixed)
CLOSR_DEFAULT_PROVIDER=openai
CLOSR_FALLBACK_PROVIDER=google
CLOSR_OPENAI_CHAT_MODEL=gpt-4o-mini
CLOSR_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CLOSR_GOOGLE_CHAT_MODEL=gemini-2.5-flash
CLOSR_GOOGLE_EMBEDDING_MODEL=models/text-embedding-004

# Optional explicit embedding provider override ("openai" or "google")
CLOSR_EMBEDDING_PROVIDER=

# Default sampling temperature
CLOSR_TEMPERATURE=0.2

# Paths for MCP server configuration and vector store persistence
CLOSR_MCP_CONFIG_PATH=mcp_servers.json
CLOSR_VECTORSTORE_DIR=.closr_data/vectorstore

# Seedance (BytePlus Ark) Video Generation
SEEDANCE_API_KEY=
CLOSR_SEEDANCE_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
CLOSR_SEEDANCE_MODEL=seedance-1-0-pro-250528
CLOSR_SEEDANCE_DEFAULT_RATIO=16:9
CLOSR_SEEDANCE_DEFAULT_RESOLUTION=720p
CLOSR_SEEDANCE_DEFAULT_DURATION=5
CLOSR_VIDEO_OUTPUT_DIR=.closr_data/videos
